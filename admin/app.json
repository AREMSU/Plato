{
  "expo": {
    "name": "Plato Admin",
    "slug": "plato-admin",
    "scheme": "platoadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platofood.admin",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.platofood.admin",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#FF6B35"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "938108df-9499-456f-bad9-29925ffc1778"
      }
    },
    "owner": "surajpatel1007"
  }
}
